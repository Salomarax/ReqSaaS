@{
    ViewData["UseSideBar"] = false;
    ViewData["Title"] = "Login - ";
}

<div class="container">
    <!-- Calendario -->
    <div class="calendar-box">
        <div class="calendar-content">
            <h3 style="color: green;">Calendario de Feriados</h3>
            <div id="calendar"></div>
            <br />
            <div id="feriadoList"></div>
        </div>
    </div>

    <!-- Login -->
    <div class="login-box">
        <div class="login-form">
            <div class="brand text-center mb-3">
                <img src="~/img/reqsaas-logo.png"
                     alt="ReqSaaS"
                     class="img-fluid"
                     style="max-height:120px;margin-bottom:8px"
                     asp-append-version="true" />
            </div>

            <h4>Iniciar Sesión</h4>

            @Html.ValidationSummary(false, "", new { @class = "text-danger", style = "text-align:left" })

            <form method="post" asp-action="Login" asp-controller="Home">
                @Html.AntiForgeryToken()

                @if (Context.Request.Query.ContainsKey("returnUrl"))
                {
                    <input type="hidden" name="returnUrl" value="@Context.Request.Query["returnUrl"]" />
                }

                <input type="text" name="Rut"
                       placeholder="Ej: 12345678K "
                       autocomplete="username"
                       inputmode="text"
                       pattern="^[0-9]+-?[0-9Kk]$"
                       title="Ingresa el RUT con o sin guion (ej: 12345678K o 12345678-K)"
                       required />

                <input type="password"
                       name="Password"
                       placeholder="Contraseña"
                       autocomplete="current-password"
                       required />

                <!--
                <label style="display:flex;align-items:center;gap:8px;margin:8px 0;">
                    <input type="checkbox" name="RememberMe" />
                    Recordarme
                </label>
                -->

                <button type="submit">Entrar</button>
            </form>

            <p style="font-size: 0.85em;">¿Problemas con el ingreso? Contácta al administrador</p>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.8/index.global.min.js"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var calendarEl = document.getElementById('calendar');
            var feriadoList = document.getElementById('feriadoList');

            // Parse "YYYY-MM-DD" como fecha LOCAL (evita desfase UTC)
            function parseLocalDate(isoDate) {
                if (!isoDate) return null;
                const s = String(isoDate).slice(0, 10); // "YYYY-MM-DD"
                const parts = s.split('-').map(Number);
                if (parts.length !== 3) return null;
                const [y, m, d] = parts;
                if (!y || !m || !d) return null;
                return new Date(y, m - 1, d); // local time
            }

            var calendar = new FullCalendar.Calendar(calendarEl, {
                initialView: 'dayGridMonth',
                locale: 'es',

                // FullCalendar pedirá eventos aquí:
                events: async function (info, successCallback, failureCallback) {
                    try {
                        const url = '@Url.Action("GetFeriados", "Home")';
                        const res = await fetch(url, { redirect: 'follow' });

                        if (!res.ok) {
                            const msg = await res.text();
                            throw new Error(msg || ('HTTP ' + res.status));
                        }

                        const json = await res.json();
                        const data = Array.isArray(json) ? json : (json.data ?? json.items ?? json.result ?? []);

                        // Eventos para el calendario
                        const eventos = (data || []).map(h => {
                            const title = h.title ?? h.nombre ?? h.Nombre ?? 'Feriado';
                            const start = h.date ?? h.fecha ?? h.Fecha ?? null;
                            return start ? { title, start } : null;
                        }).filter(Boolean);

                        successCallback(eventos);

                        // Lista “Feriados del mes” según mes/año de la vista del calendario
                         const viewDate = calendar.getDate();      // fecha del mes actualmente mostrado
                        const mesVista0 = viewDate.getMonth();
                        const anioVista = viewDate.getFullYear();


                        const feriadosMes = (data || []).filter(h => {
                            const s = h.date ?? h.fecha ?? h.Fecha;
                            const d = parseLocalDate(s);
                            return d && d.getFullYear() === anioVista && d.getMonth() === mesVista0;
                        });

                        feriadoList.innerHTML =
                            "<h4>Feriados del mes:</h4>" +
                            (feriadosMes.length
                                ? "<ul>" + feriadosMes.map(h => {
                                    const nombre = h.title ?? h.nombre ?? h.Nombre ?? 'Feriado';
                                    const irr = (h.inalienable ?? h.irrenunciable ?? h.Irrenunciable ?? h.mandatory ?? h.obligatorio)
                                        ? " (Irrenunciable)" : "";
                                    return `<li>${nombre}${irr}</li>`;
                                }).join('') + "</ul>"
                                : "<p>No hay feriados este mes.</p>");

                    } catch (error) {
                        feriadoList.innerHTML = "<p style='color: red;'>No se pudo cargar la información de feriados.</p>";
                        console.error('[Feriados] Error cargando datos:', error);
                        if (failureCallback) failureCallback(error);
                    }
                }
            });

            calendar.render();
        });
    </script>

    <script>
        // Normaliza el RUT al enviar y al salir del campo: 12345678-K (sin puntos, con guion, DV en mayúscula)
        (function () {
            const form = document.querySelector('form[asp-action="Login"][asp-controller="Home"]');
            if (!form) return;

            function normalizeRut(v) {
                if (!v) return v;
                const raw = v.replace(/[^0-9kK]/g, '');
                if (raw.length < 2) return v;
                const cuerpo = raw.slice(0, -1);
                const dv = raw.slice(-1).toUpperCase();
                return `${cuerpo}-${dv}`;
            }

            const rutInput = form.querySelector('input[name="Rut"]');
            if (rutInput) {
                rutInput.addEventListener('blur', () => {
                    rutInput.value = normalizeRut(rutInput.value);
                });
            }

            form.addEventListener('submit', () => {
                if (rutInput) rutInput.value = normalizeRut(rutInput.value);
            });
        })();
    </script>

    <partial name="_ValidationScriptsPartial" />
}
