@{
    ViewData["Title"] = "Requisitos Normativos";
    ViewData["UseSideBar"] = true;
    var canCrud = User.HasClaim("nivel", "2") || User.HasClaim("nivel", "3");
}

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&display=swap" rel="stylesheet" />

<style>
  
    .page-header {
        text-align: center;
        margin: 8px 0 18px;
    }

        .page-header h2 {
            color: #2e7d32;
            margin: 0 0 6px;
            font-family: 'Inter',sans-serif;
        }

        .page-header p {
            color: #6b7280;
            margin: 0;
        }

    .filters {
        display: flex;
        gap: 10px;
        justify-content: center;
        flex-wrap: wrap;
        margin-bottom: 16px;
    }

        .filters input, .filters select, .filters button {
            padding: 10px;
            border-radius: 8px;
            border: 1px solid #e5e7eb;
            font-size: 14px;
            background: #fff;
        }

        .filters button {
            background: #388e3c;
            color: #fff;
            border: none;
            cursor: pointer;
        }

    .table-wrapper {
        background: #fff;
        border-radius: 14px;
        padding: 20px;
        box-shadow: 0 8px 24px rgba(0,0,0,.08);
    }

    table {
        width: 100%;
        border-collapse: collapse;
        font-size: 14px;
    }

    th, td {
        padding: 12px 10px;
        border-bottom: 1px solid #eef2f7;
        text-align: left;
    }

    th {
        background: #f8fafc;
        color: #0f172a;
        font-weight: 600;
    }

    .badge {
        padding: 6px 10px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 600;
        display: inline-block;
    }

    .badge-purple {
        background: #e9d5ff;
        color: #4c1d95;
    }

    .badge-blue {
        background: #dbeafe;
        color: #1e40af;
    }

    .badge-green {
        background: #dcfce7;
        color: #166534;
    }

    .badge-gray {
        background: #e5e7eb;
        color: #374151;
    }

    .progress {
        background: #e5e7eb;
        border-radius: 10px;
        height: 8px;
        width: 160px;
        overflow: hidden;
        display: inline-block;
        vertical-align: middle;
        margin-right: 6px;
    }

        .progress > div {
            background: #16a34a;
            height: 100%;
        }

    .muted {
        color: #6b7280;
    }

    .actions a {
        text-decoration: none;
        margin-right: 10px;
        font-size: 18px;
    }

    .center {
        text-align: center;
        color: #64748b;
    }
</style>

<div class="page">
    <div class="page-header">
        <h2>Requisitos Normativos con Estado de Cumplimiento</h2>
        <p>Estado actual de cumplimiento y progreso de cada requisito normativo</p>
    </div>

    <div class="filters">
        <select >
            <option value="">Todos los estados</option>
            <option value="">En Cumplimiento</option>
            <option value="">En Proceso</option>
        </select>
        <select id="flt-tipo">
            <option value="">Todos los tipos</option>
        </select>
        <button type="button" id="btn-filtrar">Filtrar</button>
    </div>

    <div class="table-wrapper">
        <table>
            <thead>
                <tr>
                    <th>N°</th>
                    <th>Requisito</th>
                    <th>Tipo</th>
                    <th>Estado</th>
                    <th>Cumplimiento</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody id="req-rows">
                <tr><td colspan="6" class="center">Cargando…</td></tr>
            </tbody>
        </table>
    </div>
</div>

<!-- Modal confirmación borrado -->
<div class="modal fade" id="confirmDeleteModal" tabindex="-1" aria-labelledby="confirmDeleteLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form method="post" action="@Url.Action("DeleteReq","Modify")">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="deleteReqId" />
                <div class="modal-header">
                    <h5 class="modal-title" id="confirmDeleteLabel">Confirmar eliminación</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-1 fw-semibold">¿Seguro que desea borrar todo el requisito y sus evidencias?</p>
                    <small class="text-muted">Se eliminarán todos los ítems asociados y sus archivos/URLs de evidencia. Esta acción es irreversible.</small>
                    <div class="mt-3 p-2 bg-light rounded border">
                        <span class="text-secondary">Requisito:</span>
                        <span id="deleteReqTitle" class="fw-medium"></span>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-danger">Sí, borrar todo</button>
                </div>
            </form>
        </div>
    </div>
</div>

@{
    // Plantillas con marcador __ID__
    var viewUrlTpl = Url.Action("ReqDetails", "Home", new { id = "__ID__", ro = true });
    var evalUrlTpl = Url.Action("ReqDetails", "Home", new { id = "__ID__" });
}

@section Scripts {
    <script>
        (() => {
          const urlResumen = '@Url.Action("RequisitosResumen", "Home")';
          const urlTipos   = '@Url.Action("Tipos", "Home")';

          // Inyectamos las plantillas desde Razor (sin &amp;)
          const viewUrlTpl = '@Html.Raw(viewUrlTpl)';
          const evalUrlTpl = '@Html.Raw(evalUrlTpl)';

          const $rows = document.getElementById('req-rows');
          const $txt  = document.getElementById('flt-text');
          const $tipo = document.getElementById('flt-tipo');
          const $btn  = document.getElementById('btn-filtrar');

          let data = [];
          let tiposMap = new Map(); // id -> nombre

          const get = (o, keys, def=null) => {
            for (const k of keys) if (o != null && o[k] !== undefined && o[k] !== null) return o[k];
            return def;
          };

          const estadoBadge = (pct) => pct>=100 ? `<span class="badge badge-green">Cumplido</span>`
                                 : pct>0 ? `<span class="badge badge-blue">En proceso</span>`
                                 : `<span class="badge badge-gray">Pendiente</span>`;
          const fmtNro = id => "REQ-" + String(id ?? '').padStart(3,'0');
          const tipoNombre = (id) => tiposMap.get(Number(id)) || '—';

          function render(list){
            if (!Array.isArray(list) || list.length===0){
              $rows.innerHTML = `<tr><td colspan="6" class="center">No hay requisitos para mostrar.</td></tr>`;
              return;
            }

            $rows.innerHTML = list.map((r, idx) => {
              const id        = get(r, ['IdReq','idReq','id'], '');
              const titulo    = get(r, ['Titulo','titulo'], '');
              const entidad   = get(r, ['Entidad','entidad'], '—');
              const idTipo    = get(r, ['IdTipo','idTipo'], null);
              const total     = get(r, ['Total','total'], 0);
              const ok        = get(r, ['Cumplidos','cumplidos'], 0);
              const porcentaje= Math.max(0, Math.min(100, Math.round(get(r, ['Porcentaje','porcentaje'], 0))));
              const bcn       = get(r, ['NormaIDBCN','normaIDBCN','normaIdBcn'], '—');

              return `
                <tr>
                  <td><span class="badge badge-purple" title="ID real: ${id}">${idx + 1}</span></td>
                  <td>
                    <div style="font-weight:600;color:#111827">${titulo}</div>
                    <div class="muted">Entidad: ${entidad} · BCN ${bcn}</div>
                  </td>
                  <td><span class="pill">${tipoNombre(idTipo)}</span></td>
                  <td>${estadoBadge(porcentaje)}</td>
                  <td>
                    <span class="progress"><div style="width:${porcentaje}%"></div></span>
                    <small>${porcentaje}% — ${ok} de ${total} artículos</small>
                  </td>
                  <td class="actions">
                    <a title="Ver" href="${viewUrlTpl.replace('__ID__', id)}">👁️</a>
                    @if (canCrud)
                    {
                          <text>
                            <a title="Evaluar" href="${evalUrlTpl.replace('__ID__', id)}">✏️</a>
                            <a title="Eliminar"
                               href="#"
                               class="btn-delete"
                               data-id="${id}"
                               data-title="${(titulo||'').replace(/"/g,'&quot;')}">🗑️</a>
                          </text>
                    }
                  </td>
                </tr>`;
            }).join('');
          }

          function applyFilter(){
            const q = ($txt.value||'').toLowerCase().trim();
            const t = $tipo.value;
            let list = data.slice();

            if (q) list = list.filter(r =>
              (get(r,['Titulo','titulo'],'').toLowerCase().includes(q)) ||
              (get(r,['Entidad','entidad'],'').toLowerCase().includes(q))
            );
            if (t) list = list.filter(r => String(get(r,['IdTipo','idTipo'], '')) === t);

            render(list);
          }

          async function loadTipos(){
            try{
              const res = await fetch(urlTipos, { cache:'no-store', credentials:'same-origin' });
              if (!res.ok) throw new Error('HTTP ' + res.status);
              const lista = await res.json(); // [{id, nombre}]
              tiposMap = new Map((lista || []).map(t => [Number(t.id), t.nombre]));
              document.getElementById('flt-tipo').innerHTML =
                `<option value="">Todos los tipos</option>` +
                (lista || []).map(t => `<option value="${t.id}">${t.nombre}</option>`).join('');
            }catch{
              // si falla, dejamos solo "Todos los tipos"
            }
          }

          async function loadResumen(){
            try{
              const res = await fetch(urlResumen, { cache:'no-store', credentials:'same-origin' });
              if(!res.ok){
                const txt = await res.text();
                try{ const j = JSON.parse(txt);
                     const msg = j.detail || j.error || txt;
                     $rows.innerHTML = `<tr><td colspan="6" class="center" style="color:#b91c1c">Error al cargar el resumen: ${msg}</td></tr>`;
                }catch{
                     $rows.innerHTML = `<tr><td colspan="6" class="center" style="color:#b91c1c">Error al cargar el resumen: HTTP ${res.status}</td></tr>`;
                }
                return;
              }
              const json = await res.json();
              if(!Array.isArray(json)){
                $rows.innerHTML = `<tr><td colspan="6" class="center" style="color:#b91c1c">Formato inesperado del resumen.</td></tr>`;
                return;
              }
              data = json;
              render(data);
            }catch(e){
              console.error(e);
              $rows.innerHTML = `<tr><td colspan="6" class="center" style="color:#b91c1c">Error al cargar el resumen (ver consola).</td></tr>`;
            }
          }

          $btn.addEventListener('click', applyFilter);

          if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', () => { loadTipos(); loadResumen(); });
          } else {
            loadTipos(); loadResumen();
          }
        })();

        // Delegación: abrir modal al click en 🗑️
        document.addEventListener('click', function (e) {
          const a = e.target.closest('.btn-delete');
          if (!a) return;
          e.preventDefault();

          const id = a.getAttribute('data-id');
          const title = a.getAttribute('data-title') || 'Sin título';

          document.getElementById('deleteReqId').value = id;
          document.getElementById('deleteReqTitle').textContent = title;

          // Bootstrap Modal (requiere bootstrap.bundle.js)
          const modalEl = document.getElementById('confirmDeleteModal');
          const modal = new bootstrap.Modal(modalEl);
          modal.show();
        });
    </script>
}
