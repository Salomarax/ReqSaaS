@{
    ViewData["Title"] = "Requisitos Normativos";
    ViewData["UseSideBar"] = true;
    var canCrud = User.HasClaim("nivel", "2") || User.HasClaim("nivel", "3");
}

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&display=swap" rel="stylesheet" />



<div class="page page--fluid">

    <div class="page-header">
        <h2>Resumen Evaluación de Requisitos</h2>
        <p>Estado actual de cumplimiento y progreso de cada requisito normativo</p>
    </div>

    <div class="filters filters--compact">
        <select id="flt-estado">
            <option value="">Todos los estados</option>
            <option value="C">En Cumplimiento</option>
            <option value="P">En Proceso</option>
        </select>

        <select id="flt-tipo">
            <option value="">Todos los tipos</option>
        </select>

        <button type="button" id="btn-clear">Borrar filtros</button>
    </div>

    <div class="table-wrapper">
        <table>
            <thead>
                <tr>
                    <th>N°</th>
                    <th>Requisito</th>
                    <th>Tipo</th>
                    <th>Estado</th>
                    <th>Cumplimiento</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody id="req-rows">
                <tr><td colspan="6" class="center">Cargando…</td></tr>
            </tbody>
        </table>
    </div>
</div>

<!-- Modal confirmación borrado -->
<div class="modal fade" id="confirmDeleteModal" tabindex="-1" aria-labelledby="confirmDeleteLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form method="post" action="@Url.Action("DeleteReq","Modify")">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="deleteReqId" />
                <div class="modal-header">
                    <h5 class="modal-title" id="confirmDeleteLabel">Confirmar eliminación</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-1 fw-semibold">¿Seguro que desea borrar todo el requisito y sus evidencias?</p>
                    <small class="text-muted">Se eliminarán todos los ítems asociados y sus archivos/URLs de evidencia. Esta acción es irreversible.</small>
                    <div class="mt-3 p-2 bg-light rounded border">
                        <span class="text-secondary">Requisito:</span>
                        <span id="deleteReqTitle" class="fw-medium"></span>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-danger">Sí, borrar todo</button>
                </div>
            </form>
        </div>
    </div>
</div>

@{
    // Plantillas con marcador __ID__
    var viewUrlTpl = Url.Action("ReqDetails", "Home", new { id = "__ID__", ro = true });
    var evalUrlTpl = Url.Action("ReqDetails", "Home", new { id = "__ID__" });
}
@section Scripts {
    <script>
        (() => {
          /* ============================
             Endpoints que usa la vista
             ============================ */
          const urlResumen = '@Url.Action("RequisitosResumen", "Home")'; 
          const urlTipos   = '@Url.Action("Tipos", "Home")';             

          /* ==========================================================
             Plantillas de URL para acciones (con marcador __ID__)
             ========================================================== */
          const viewUrlTpl = '@Html.Raw(viewUrlTpl)'; // plantilla para “Ver”
          const evalUrlTpl = '@Html.Raw(evalUrlTpl)'; // plantilla para “Evaluar”

          /* ============================
             Referencias a elementos DOM
             ============================ */
          const $rows    = document.getElementById('req-rows');                
          const $txt     = document.getElementById('flt-text');                
          const $tipo    = document.getElementById('flt-tipo');               
          const $estado  = document.querySelector('.filters select:not(#flt-tipo)');
          // Botón “Borrar filtros”. Si no existe 
          const $btnClear = document.getElementById('btn-clear') || document.getElementById('btn-filtrar');

          /* ============================
             Estado en memoria (data cruda)
             ============================ */
          let data = [];              
          let tiposMap = new Map();   // diccionario idTipo -> nombre

          /* -----------------------------------------------------------------
             util get(): acceso seguro a propiedades (acepta varias claves)
             ----------------------------------------------------------------- */
          const get = (o, keys, def=null) => {
            for (const k of keys) // recorre posibles nombres de la misma propiedad
              if (o != null && o[k] !== undefined && o[k] !== null) return o[k];
            return def;           // si ninguna existe, devuelve el valor por defecto
          };

          /* -----------------------------------------------------------------
             pctOf(): devuelve el % de cumplimiento de un registro
             - usa r.Porcentaje si viene
             - si no, lo calcula con Cumplidos/Total
             - siempre entre 0 y 100
             ----------------------------------------------------------------- */
          const pctOf = (r) => {
            let pct = get(r, ['Porcentaje','porcentaje'], null);
            if (pct == null) {                                    
              const ok    = Number(get(r, ['Cumplidos','cumplidos'], 0));
              const total = Number(get(r, ['Total','total'], 0));
              pct = total > 0 ? Math.round((ok / total) * 100) : 0;
            }
            pct = Number.isFinite(pct) ? pct : 0;                 // sanea valores raros
            return Math.max(0, Math.min(100, pct));               // clamp 0..100
          };

          /* -----------------------------------------------------------------
             estadoBadge(): solo dos estados visuales
             - 100% => En Cumplimiento
             - resto => En Proceso
             ----------------------------------------------------------------- */
          const estadoBadge = (pct) =>
            pct >= 100
              ? `<span class="badge badge-blue">En Cumplimiento</span>`
              : `<span class="badge badge-yellow">En Proceso</span>`;

          // Devuelve el nombre del tipo desde el map (si no, '—')
          const tipoNombre = (id) => tiposMap.get(Number(id)) || '—';

          /* -----------------------------------------------------------------
             readEstadoFilter(): lee el filtro de estado del <select>
             Devuelve:
               ''  -> sin filtro
               'C' -> En Cumplimiento
               'P' -> En Proceso
             Usa .value si existe, y si no intenta inferir por el texto visible.
             ----------------------------------------------------------------- */
          const readEstadoFilter = () => {
            if (!$estado) return '';                             
            const val = ($estado.value || '').trim();           
            if (val) return val;                                

            // Fallback: deduce por el texto del option seleccionado
            const txt = ($estado.options[$estado.selectedIndex]?.text || '').toLowerCase();
            if (txt.includes('cumpl')) return 'C';
            if (txt.includes('proce')) return 'P';
            return '';
          };

          /* -----------------------------------------------------------------
             render(): pinta la tabla a partir de una lista de requisitos
             ----------------------------------------------------------------- */
          function render(list){
            if (!Array.isArray(list) || list.length === 0) {
              // Mensaje vacío si no hay datos que mostrar
              $rows.innerHTML = `<tr><td colspan="6" class="center">No hay requisitos para mostrar.</td></tr>`;
              return;
            }

            // Construye todas las filas de una vez (mejor perf que innerHTML por fila)
            $rows.innerHTML = list.map((r, idx) => {
              const id        = get(r, ['IdReq','idReq','id'], '');
              const titulo    = get(r, ['Titulo','titulo'], '');
              const entidad   = get(r, ['Entidad','entidad'], '—');
              const idTipo    = get(r, ['IdTipo','idTipo'], null);
              const total     = get(r, ['Total','total'], 0);
              const ok        = get(r, ['Cumplidos','cumplidos'], 0);
              const pct       = pctOf(r);
              const bcn       = get(r, ['NormaIDBCN','normaIDBCN','normaIdBcn'], '—');

              return `
                <tr>
                  <td><span class="badge badge-purple" title="ID real: ${id}">${idx + 1}</span></td>
                  <td>
                    <div style="font-weight:600;color:#111827">${titulo}</div>
                    <div class="muted">Entidad: ${entidad} · BCN ${bcn}</div>
                  </td>
                  <td><span class="pill">${tipoNombre(idTipo)}</span></td>
                  <td>${estadoBadge(pct)}</td>
                  <td>
                    <span class="progress"><div style="width:${pct}%"></div></span>
                    <small>${pct}% — ${ok} de ${total} artículos</small>
                  </td>
                  <td class="actions">
                    <a title="Ver" href="${viewUrlTpl.replace('__ID__', id)}">👁️</a>
                    @if (canCrud)
                    {
                          <text>
                            <a title="Evaluar" href="${evalUrlTpl.replace('__ID__', id)}">✏️</a>
                            <a title="Eliminar"
                               href="#"
                               class="btn-delete"
                               data-id="${id}"
                               data-title="${(titulo||'').replace(/"/g,'&quot;')}">🗑️</a>
                          </text>
                    }
                  </td>
                </tr>`;
            }).join('');
          }

          /* -----------------------------------------------------------------
             applyFilter(): aplica los filtros actuales sobre `data` y repinta
             - Texto (si existe #flt-text)
             - Tipo  (#flt-tipo)
             - Estado (primer <select> de .filters)
             ----------------------------------------------------------------- */
          function applyFilter(){
            const q = (($txt && $txt.value) || '').toLowerCase().trim(); 
            const t = ($tipo && $tipo.value) || '';                      
            const e = readEstadoFilter();                               

            let list = data.slice();                                   

            // Filtro de texto: título o entidad
            if (q) {
              list = list.filter(r =>
                (get(r,['Titulo','titulo'],'').toLowerCase().includes(q)) ||
                (get(r,['Entidad','entidad'],'').toLowerCase().includes(q))
              );
            }

            // Filtro por tipo
            if (t) list = list.filter(r => String(get(r,['IdTipo','idTipo'], '')) === t);

            // Filtro por estado (se deriva del %)
            if (e) list = list.filter(r => (pctOf(r) >= 100 ? 'C' : 'P') === e);

            render(list);                                                // repintar con el resultado
          }

          /* -----------------------------------------------------------------
             loadTipos(): carga catálogo de tipos y llena #flt-tipo
             ----------------------------------------------------------------- */
          async function loadTipos(){
            try {
              const res = await fetch(urlTipos, { cache:'no-store', credentials:'same-origin' });
              if (!res.ok) throw new Error('HTTP ' + res.status);

              const lista = await res.json();                            // [{ id, nombre }]
              tiposMap = new Map((lista || []).map(t => [Number(t.id), t.nombre]));

              if ($tipo) {
                // Option vacío (Todos) + options del backend
                $tipo.innerHTML =
                  `<option value="">Todos los tipos</option>` +
                  (lista || []).map(t => `<option value="${t.id}">${t.nombre}</option>`).join('');
              }
            } catch {
              // si falla, dejamos solo “Todos los tipos”
            }
          }

          /* -----------------------------------------------------------------
             loadResumen(): trae los requisitos y realiza el primer render
             ----------------------------------------------------------------- */
          async function loadResumen(){
            try{
              const res = await fetch(urlResumen, { cache:'no-store', credentials:'same-origin' });
              if(!res.ok){
                // Manejo de error 
                const txt = await res.text();
                try{
                  const j = JSON.parse(txt);
                  const msg = j.detail || j.error || txt;
                  $rows.innerHTML = `<tr><td colspan="6" class="center" style="color:#b91c1c">Error al cargar el resumen: ${msg}</td></tr>`;
                }catch{
                  $rows.innerHTML = `<tr><td colspan="6" class="center" style="color:#b91c1c">Error al cargar el resumen: HTTP ${res.status}</td></tr>`;
                }
                return;
              }

              const json = await res.json();                             // espera un array
              if(!Array.isArray(json)){
                $rows.innerHTML = `<tr><td colspan="6" class="center" style="color:#b91c1c">Formato inesperado del resumen.</td></tr>`;
                return;
              }

              data = json;                                               // guardamos data cruda
              render(data);                                              // primer pintado sin filtros
            }catch(e){
              console.error(e);
              $rows.innerHTML = `<tr><td colspan="6" class="center" style="color:#b91c1c">Error al cargar el resumen (ver consola).</td></tr>`;
            }
          }

          /* -----------------------------------------------------------------
             clearFilters(): limpia los filtros y repinta TODO otra vez
             ----------------------------------------------------------------- */
          function clearFilters(ev){
            ev?.preventDefault();            // evita submit o navegación
            if ($txt)    $txt.value    = ''; // limpia texto
            if ($tipo)   $tipo.value   = ''; // limpia tipo
            if ($estado) $estado.value = ''; // limpia estado 
            if ($estado && !$estado.value) $estado.selectedIndex = 0; // asegura seleccionar la 1ª opción

            // Si ya hay data, zctualizamos con todo. si aún no, la cargamos nueva

            if (data && data.length) render(data); else loadResumen();
          }

          /* ============================
             Eventos (filtros en vivo)
             ============================ */
          if ($tipo)    $tipo.addEventListener('change', applyFilter); // al cambiar el tipo
          if ($estado)  $estado.addEventListener('change', applyFilter); // al cambiar el estado
          if ($txt)     $txt.addEventListener('input',  applyFilter); // búsqueda en vivo
          if ($btnClear) $btnClear.addEventListener('click', clearFilters); // “Borrar filtros”

          /* ============================
             Arranque (bootstrap inicial)
             ============================ */
          if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', () => { loadTipos(); loadResumen(); });
          } else {
            loadTipos(); loadResumen();
          }
        })();
    </script>

    <script>
        /* -----------------------------------------------------------------
           Delegación para abrir el modal de eliminar (ícono 🗑️)
           ----------------------------------------------------------------- */
        document.addEventListener('click', function (e) {
          const a = e.target.closest('.btn-delete'); 
          if (!a) return;                             
          e.preventDefault();                         

          const id    = a.getAttribute('data-id');    
          const title = a.getAttribute('data-title') || 'Sin título'; // título amigable

          // Inyecta datos en el modal
          document.getElementById('deleteReqId').value = id;
          document.getElementById('deleteReqTitle').textContent = title;

          // Muestra el modal (requiere bootstrap.bundle.js)
          const modalEl = document.getElementById('confirmDeleteModal');
          const modal = new bootstrap.Modal(modalEl);
          modal.show();
        });
    </script>
}
