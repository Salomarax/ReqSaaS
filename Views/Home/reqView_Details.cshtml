@model ReqSaaS_1.Models.RequisitoDetalleVM
@{
    ViewData["Title"] = "Detalle del Requisito";
    ViewData["UseSideBar"] = true;
    bool readOnly = ViewBag.ReadOnly == true;
}

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&display=swap" rel="stylesheet" />


<div class="page page--fluid">

    <div class="card header">
        <div class="top-actions">
            <h3>@Model.Titulo</h3>
            <a href="@Url.Action("reqView", "Home")" class="btn-outline-green">← Volver</a>
        </div>
        <div class="muted">
            <span class="pill">@((Model.TipoNombre ?? "—"))</span>
            &nbsp;|&nbsp; Entidad: @((Model.Entidad ?? "—"))
            &nbsp;|&nbsp; BCN: @(Model.NormaIDBCN?.ToString() ?? "—")
        </div>
    </div>

    <div class="card">
        @if (TempData["ok"] != null)
        {
            <div class="muted" style="margin-bottom:10px;color:#166534">✔ @TempData["ok"]</div>
        }

        <form asp-action="ReqDetails" asp-controller="Home" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="IdReq" />

            <!-- Usamos SIEMPRE fieldset y lo deshabilitamos según readOnly -->
            <fieldset @(readOnly ? "disabled" : "")>
                @if (Model.Items != null && Model.Items.Count > 0)
                {
                    <table>
                        <thead>
                            <tr>
                                <th style="width:5%">N°</th>
                                <th style="width:50%">Detalle</th>
                                <th style="width:10%">Cumple</th>
                                <th style="width:25%">Justificación</th>
                                <th style="width:10%">Evidencia (URL)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.Items.Count; i++)
                            {
                                <tr>
                                    
                                    <td class="muted">@(i + 1)

                                    </td>
                                      
                                    <td>
                                        <div class="item-detalle">@Model.Items[i].Detalle</div>
                                    </td>
                                    <td>
                                        <input class="form-check-input" asp-for="Items[i].Cumplimiento" type="checkbox" />
                                    </td>
                                    <td>
                                        <textarea class="form-control" asp-for="Items[i].Justificacion"></textarea>
                                    </td>
                                    <td>
                                        <input class="form-control" asp-for="Items[i].ArchivoUrl" />
                                    </td>
                                </tr>
                                <input type="hidden" asp-for="Items[i].IdItem" />
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="muted">Este requisito aún no tiene ítems cargados.</div>
                }
            </fieldset>

            @if (!readOnly)
            {
                <div class="actions">
                    <button type="submit" class="btn">Guardar cambios</button>
                    <a href="@Url.Action("reqView", "Home")" class="btn gray">Cancelar</a>
                </div>
            }
            else
            {
                <div class="muted" style="margin-top:10px;">Vista de <strong>solo lectura</strong>.</div>
            }
        </form>
    </div>
</div>
